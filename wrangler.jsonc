{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "magyapro",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Remplacer par l'ID réel de la configuration Hyperdrive créée dans le
      // dashboard Cloudflare (Workers & Pages → Hyperdrive).
      "id": "REPLACE_WITH_HYPERDRIVE_ID",
      // Utilisé uniquement par `wrangler dev` en local, jamais en production
      // (l'ID ci-dessus prend le relais une fois déployé).
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:5432/magyapro_dev?schema=public"
    }
  ],
  "observability": {
    "enabled": true
  }
}
