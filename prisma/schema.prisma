// Magyapro — schéma multi-tenant.
//
// Règle structurante : toute donnée appartenant à un restaurant porte une
// colonne `restaurantId` non nullable et un index dessus. Les requêtes
// applicatives passent systématiquement par les helpers de `src/lib/tenant.ts`
// qui injectent ce filtre côté serveur — jamais depuis une valeur du client.
//
// Tous les montants sont stockés en entiers, dans l'unité mineure de la devise
// du restaurant (voir `src/lib/money.ts`). Aucun flottant pour l'argent.

generator client {
  provider   = "prisma-client-js"
  // Sans binaire Rust : nécessaire pour Cloudflare Workers, où aucun
  // exécutable natif ne peut tourner. Fonctionne identiquement sur Node
  // (Railway...) via l'adaptateur `pg` — un seul chemin pour les deux cibles.
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identité & accès
// ---------------------------------------------------------------------------

enum PlatformRole {
  USER
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  passwordHash    String
  name            String
  phone           String?
  platformRole    PlatformRole @default(USER)
  status          UserStatus   @default(ACTIVE)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  isDemo          Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  memberships      RestaurantUser[]
  /// Adhésions MagyaPro Boutique — distinctes des adhésions Restaurant : un
  /// compte peut appartenir aux deux produits sans que l'un ne connaisse
  /// l'autre.
  storeMemberships StoreUser[]
  sessions         Session[]
  tokens           VerificationToken[]
  auditLogs        AuditLog[]
  supportAccess    SupportAccess[]
  notifications    Notification[]
  courierOrders    Order[]             @relation("CourierOrders")

  @@index([platformRole])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model VerificationToken {
  id         String                @id @default(cuid())
  userId     String
  type       VerificationTokenType
  tokenHash  String                @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("verification_tokens")
}

/// Rôle d'un utilisateur **au sein d'un restaurant**. Distinct de PlatformRole.
enum MembershipRole {
  OWNER
  ADMIN
  EMPLOYEE
  /// Accès restreint à la seule section livraisons — voir `COURIER_PERMISSIONS`
  /// dans `src/lib/rbac.ts`. Le tableau de bord d'un livreur n'affiche même
  /// pas la barre latérale complète : inutile de lui montrer des rubriques
  /// auxquelles il n'a de toute façon pas accès.
  COURIER
}

model RestaurantUser {
  id               String         @id @default(cuid())
  restaurantId     String
  userId           String
  role             MembershipRole @default(EMPLOYEE)
  /// Permissions accordées en plus de celles du rôle (système extensible).
  extraPermissions String[]       @default([])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, userId])
  @@index([userId])
  @@index([restaurantId])
  @@map("restaurant_users")
}

// ---------------------------------------------------------------------------
// Tenant
// ---------------------------------------------------------------------------

enum RestaurantStatus {
  DRAFT
  ACTIVE
  SUSPENDED
}

model Restaurant {
  id          String           @id @default(cuid())
  /// Sous-domaine public : <slug>.magyapro.app
  slug        String           @unique
  name        String
  description String?
  status      RestaurantStatus @default(DRAFT)
  isDemo      Boolean          @default(false)

  // Identité visuelle
  logoUrl        String?
  coverUrl       String?
  faviconUrl     String?
  primaryColor   String  @default("#e2483d")
  secondaryColor String  @default("#12151a")
  fontFamily     String  @default("Inter")
  templateKey    String  @default("modern")

  // Mise en avant éditoriale (utilisée par le template « elegant »)
  chefName  String?
  chefBio   String?
  chefPhoto String?

  // Coordonnées
  phone       String?
  email       String?
  addressLine String?
  city        String?
  country     String?
  latitude    Float?
  longitude   Float?

  // Réseaux sociaux
  facebookUrl    String?
  instagramUrl   String?
  tiktokUrl      String?
  whatsappNumber String?

  // SEO
  seoTitle       String?
  seoDescription String?
  seoImageUrl    String?

  currency String @default("XOF")
  timezone String @default("Africa/Abidjan")

  // Onboarding
  onboardingStep        Int       @default(0)
  onboardingCompletedAt DateTime?

  /// Compteur de numérotation des commandes, incrémenté transactionnellement.
  orderCounter Int       @default(0)
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  settings             RestaurantSettings?
  subscription         Subscription?
  subscriptionPayments SubscriptionPayment[]
  members              RestaurantUser[]
  openingHours         OpeningHour[]
  categories           Category[]
  products             Product[]
  orders               Order[]
  customers            Customer[]
  deliveryZones        DeliveryZone[]
  promotions           Promotion[]
  payments             Payment[]
  domains              Domain[]
  notifications        Notification[]
  analyticsEvents      AnalyticsEvent[]
  auditLogs            AuditLog[]
  supportAccess        SupportAccess[]
  reviews              Review[]
  reservations         Reservation[]
  tables               RestaurantTable[]
  loyaltyTiers         LoyaltyTier[]
  loyaltyRewards       LoyaltyReward[]
  expenses             Expense[]
  galleryImages        GalleryImage[]

  @@index([status])
  @@map("restaurants")
}

model RestaurantSettings {
  id           String @id @default(cuid())
  restaurantId String @unique

  orderingEnabled         Boolean  @default(true)
  deliveryEnabled         Boolean  @default(true)
  pickupEnabled           Boolean  @default(true)
  /// Commande autonome depuis la table, via QR code. Distincte du droit
  /// accordé par le plan : un restaurant éligible peut choisir de ne
  /// proposer que l'appel serveur / demande d'addition, sans la commande.
  tableOrderingEnabled    Boolean  @default(false)
  /// Montant minimum de commande, toutes zones confondues (unité mineure).
  minOrderAmount          Int      @default(0)
  prepTimeMinutes         Int      @default(30)
  /// Identifiants des fournisseurs de paiement activés (voir src/lib/payments).
  paymentProviders        String[] @default(["cash_on_delivery"])
  /// Numéros receveurs du restaurant pour le paiement mobile manuel — jamais
  /// codés en dur, configurés ici.
  orangeMoneyNumber       String?
  waveNumber              String?
  notificationEmail       String?
  /// Son personnalisé joué à l'arrivée d'une commande (remplace le bip par
  /// défaut). Téléversé comme une image, mais dans le dossier `sounds`.
  notificationSoundUrl    String?
  /// Notes internes affichées au personnel dans le dashboard.
  staffNotes              String?
  /// Délai après l'heure de réservation avant qu'elle soit signalée comme
  /// probable no-show dans le dashboard (le personnel décide alors de
  /// l'annuler ou non — rien n'est automatique).
  reservationGraceMinutes Int      @default(60)

  /// TVA optionnelle : les prix affichés au client restent TTC (rien ne
  /// change dans le tunnel de commande) — le taux sert uniquement à faire
  /// apparaître la ventilation sur les reçus, pour la comptabilité du
  /// restaurateur.
  taxEnabled Boolean @default(false)
  /// Pourcentage (ex. 18 pour 18%).
  taxRate    Float?
  taxLabel   String  @default("TVA")

  /// Identifiants fournis par le restaurateur pour suivre ses propres
  /// visiteurs — jamais un identifiant Magyapro : chaque restaurant a le
  /// sien, ou aucun.
  googleAnalyticsId String?
  metaPixelId       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("restaurant_settings")
}

model OpeningHour {
  id           String  @id @default(cuid())
  restaurantId String
  /// 0 = dimanche … 6 = samedi
  dayOfWeek    Int
  isClosed     Boolean @default(false)
  /// Format "HH:MM" en heure locale du restaurant.
  opensAt      String  @default("09:00")
  closesAt     String  @default("22:00")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, dayOfWeek])
  @@index([restaurantId])
  @@map("opening_hours")
}

// ---------------------------------------------------------------------------
// Menu
// ---------------------------------------------------------------------------

model Category {
  id            String  @id @default(cuid())
  restaurantId  String
  name          String
  slug          String
  description   String?
  imageUrl      String?
  position      Int     @default(0)
  isActive      Boolean @default(true)
  /// Traductions facultatives. Vide = le site affiche le nom français.
  nameEn        String?
  nameAr        String?
  descriptionEn String?
  descriptionAr String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  products   Product[]

  @@unique([restaurantId, slug])
  @@index([restaurantId, position])
  @@map("categories")
}

enum ProductBadge {
  NONE
  POPULAR
  NEW
  PROMOTION
  SOLD_OUT
}

model Product {
  id             String       @id @default(cuid())
  restaurantId   String
  categoryId     String
  name           String
  slug           String
  description    String?
  imageUrl       String?
  /// Prix de base en unité mineure. Une variante sélectionnée le remplace.
  price          Int
  /// Ancien prix, affiché barré. Purement informatif.
  compareAtPrice Int?
  /// Coût de revient, pour le calcul de marge. Facultatif : sans lui, la
  /// marge de ce plat n'est simplement pas affichée.
  costPrice      Int?
  /// Traductions facultatives. Vide = le site affiche le nom français.
  nameEn         String?
  nameAr         String?
  descriptionEn  String?
  descriptionAr  String?
  isAvailable    Boolean      @default(true)
  badge          ProductBadge @default(NONE)
  position       Int          @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant   Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category     Category             @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  optionGroups ProductOptionGroup[]
  variants     ProductVariant[]
  orderItems   OrderItem[]

  @@unique([restaurantId, slug])
  @@index([restaurantId, categoryId, position])
  @@index([categoryId])
  @@map("products")
}

model ProductOptionGroup {
  id        String @id @default(cuid())
  productId String
  name      String
  /// Nombre minimum d'options à choisir (0 = facultatif).
  minSelect Int    @default(0)
  /// Nombre maximum d'options sélectionnables.
  maxSelect Int    @default(1)
  position  Int    @default(0)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  options ProductOption[]

  @@index([productId, position])
  @@map("product_option_groups")
}

model ProductOption {
  id          String  @id @default(cuid())
  groupId     String
  name        String
  /// Supplément appliqué au prix unitaire (unité mineure, peut être négatif).
  priceDelta  Int     @default(0)
  isAvailable Boolean @default(true)
  position    Int     @default(0)

  group ProductOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, position])
  @@map("product_options")
}

model ProductVariant {
  id          String  @id @default(cuid())
  productId   String
  name        String
  /// Prix complet de la variante (remplace le prix de base du produit).
  price       Int
  isAvailable Boolean @default(true)
  position    Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@map("product_variants")
}

// ---------------------------------------------------------------------------
// Clients & commandes
// ---------------------------------------------------------------------------

model Customer {
  id           String  @id @default(cuid())
  restaurantId String
  name         String
  phone        String
  email        String?

  /// Agrégats dénormalisés, recalculés à chaque commande créée.
  ordersCount Int       @default(0)
  totalSpent  Int       @default(0)
  lastOrderAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant     Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders         Order[]
  payments       Payment[]
  loyaltyRewards LoyaltyReward[]

  @@unique([restaurantId, phone])
  @@index([restaurantId, lastOrderAt])
  @@map("customers")
}

enum OrderStatus {
  NEW
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  /// Remise au client confirmée par le livreur (code saisi), mais le paiement
  /// espèces à la livraison n'est pas encore confirmé encaissé par le
  /// restaurant : distinct de COMPLETED, qui ne s'atteint qu'après ce constat.
  DELIVERED
  COMPLETED
  CANCELLED
}

enum FulfillmentType {
  DELIVERY
  PICKUP
  DINE_IN
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

model Order {
  id           String @id @default(cuid())
  restaurantId String
  customerId   String
  /// Numéro séquentiel par restaurant, affiché au client.
  number       Int

  status          OrderStatus     @default(NEW)
  fulfillmentType FulfillmentType @default(DELIVERY)
  paymentStatus   PaymentStatus   @default(PENDING)
  paymentProvider String?

  // Instantané des coordonnées client au moment de la commande : le profil
  // client peut changer, la commande doit rester fidèle à ce qui a été saisi.
  customerName    String
  customerPhone   String
  customerEmail   String?
  deliveryAddress String?
  /// Position GPS partagée volontairement par le client, pour aider le
  /// livreur. Absente si le client n'a rien partagé.
  deliveryLat     Float?
  deliveryLng     Float?
  instructions    String?

  // Montants recalculés côté serveur (unité mineure).
  subtotal    Int
  discount    Int    @default(0)
  deliveryFee Int    @default(0)
  total       Int
  currency    String @default("XOF")

  deliveryZoneId           String?
  promotionId              String?
  promoCode                String?
  /// Renseigné pour une commande passée depuis la table (service à table).
  tableId                  String?
  /// Livreur qui a pris en charge la course (commandes en livraison
  /// uniquement).
  courierId                String?
  /// Code à six chiffres communiqué au client, vérifié par le livreur à la
  /// remise pour confirmer qu'il livre la bonne commande à la bonne personne.
  deliveryCode             String?
  /// Position GPS du livreur, mise à jour depuis son téléphone tant que la
  /// livraison est `OUT_FOR_DELIVERY`. `null` en dehors de cette fenêtre —
  /// jamais conservée après la remise.
  courierLat               Float?
  courierLng               Float?
  courierLocationUpdatedAt DateTime?

  placedAt        DateTime  @default(now())
  statusUpdatedAt DateTime  @default(now())
  completedAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  restaurant   Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer     Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  deliveryZone DeliveryZone?    @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  promotion    Promotion?       @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  table        RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  courier      User?            @relation("CourierOrders", fields: [courierId], references: [id], onDelete: SetNull)

  items          OrderItem[]
  events         OrderStatusEvent[]
  payments       Payment[]
  review         Review?
  loyaltyRewards LoyaltyReward[]

  @@unique([restaurantId, number])
  @@index([restaurantId, status])
  @@index([restaurantId, placedAt])
  @@index([customerId])
  @@index([courierId, status])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String?
  variantId String?

  /// Instantanés : le produit peut être renommé ou supprimé ensuite.
  productName String
  variantName String?
  /// Options choisies, figées : [{ groupName, optionName, priceDelta }]
  options     Json    @default("[]")

  /// Prix unitaire options comprises (unité mineure).
  unitPrice Int
  quantity  Int
  lineTotal Int

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusEvent {
  id         String       @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  byUserId   String?
  note       String?
  createdAt  DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_events")
}

// ---------------------------------------------------------------------------
// Livraison & promotions
// ---------------------------------------------------------------------------

model DeliveryZone {
  id           String  @id @default(cuid())
  restaurantId String
  name         String
  /// Frais de livraison de la zone (unité mineure).
  fee          Int     @default(0)
  /// Montant minimum de commande pour livrer dans cette zone.
  minOrder     Int     @default(0)
  /// Au-delà de ce sous-total, la livraison est offerte. Null = jamais.
  freeAbove    Int?
  isActive     Boolean @default(true)
  position     Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@index([restaurantId, position])
  @@map("delivery_zones")
}

enum PromotionType {
  PERCENT
  FIXED
}

model Promotion {
  id             String        @id @default(cuid())
  restaurantId   String
  code           String
  type           PromotionType
  /// Pourcentage (1-100) si PERCENT, montant en unité mineure si FIXED.
  value          Int
  minOrder       Int           @default(0)
  maxRedemptions Int?
  usedCount      Int           @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  isActive       Boolean       @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant     Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders         Order[]
  loyaltyRewards LoyaltyReward[]

  @@unique([restaurantId, code])
  @@index([restaurantId])
  @@map("promotions")
}

// ---------------------------------------------------------------------------
// Fidélité
// ---------------------------------------------------------------------------

model LoyaltyTier {
  id             String        @id @default(cuid())
  restaurantId   String
  /// Nom du palier, ex. « Argent », « Habitué ».
  name           String
  /// Seuil de dépenses cumulées déclenchant l'obtention (unité mineure).
  thresholdSpent Int
  /// Récompense accordée : un code promo généré automatiquement, du même
  /// type qu'un code manuel (pourcentage ou montant fixe).
  rewardType     PromotionType
  rewardValue    Int
  position       Int           @default(0)
  isActive       Boolean       @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  rewards    LoyaltyReward[]

  @@index([restaurantId, thresholdSpent])
  @@map("loyalty_tiers")
}

/// Une ligne par récompense effectivement accordée — au plus une par couple
/// (client, palier), pour ne jamais récompenser deux fois le même seuil.
model LoyaltyReward {
  id           String   @id @default(cuid())
  restaurantId String
  customerId   String
  tierId       String
  promotionId  String
  /// Commande qui a fait franchir le seuil.
  orderId      String
  grantedAt    DateTime @default(now())

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tier       LoyaltyTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  promotion  Promotion   @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([customerId, tierId])
  @@index([restaurantId, orderId])
  @@map("loyalty_rewards")
}

// ---------------------------------------------------------------------------
// Service à table
// ---------------------------------------------------------------------------

enum TableStatus {
  FREE
  OCCUPIED
  NEEDS_CLEANING
}

model RestaurantTable {
  id           String      @id @default(cuid())
  restaurantId String
  /// Nom affiché au personnel, ex. "Table 4" ou "Terrasse 2".
  label        String
  /// Identifiant imprévisible utilisé dans l'URL du QR code — jamais l'id
  /// interne, pour ne pas exposer de numérotation séquentielle devinable.
  token        String      @unique @default(cuid())
  status       TableStatus @default(FREE)
  position     Int         @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@index([restaurantId, position])
  @@map("restaurant_tables")
}

// ---------------------------------------------------------------------------
// Avis clients & réservations
// ---------------------------------------------------------------------------

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id           String       @id @default(cuid())
  restaurantId String
  /// Un avis peut être rattaché à une commande livrée (avis vérifié), ou
  /// laissé librement depuis le site public.
  orderId      String?      @unique
  customerName String
  /// Note de 1 à 5, contrôlée en base comme en validation applicative.
  rating       Int
  comment      String?
  status       ReviewStatus @default(PENDING)
  moderatedAt  DateTime?

  createdAt DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order      Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([restaurantId, status, createdAt])
  @@map("reviews")
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Reservation {
  id               String            @id @default(cuid())
  restaurantId     String
  customerName     String
  customerPhone    String
  partySize        Int
  reservedFor      DateTime
  notes            String?
  status           ReservationStatus @default(PENDING)
  /// Code communiqué au client, à présenter sur place.
  confirmationCode String            @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, reservedFor])
  @@index([restaurantId, status])
  @@map("reservations")
}

// ---------------------------------------------------------------------------
// Paiements
// ---------------------------------------------------------------------------

model Payment {
  id               String        @id @default(cuid())
  restaurantId     String
  orderId          String?
  customerId       String?
  /// Identifiant du PaymentProvider (src/lib/payments/registry.ts).
  provider         String
  amount           Int
  currency         String        @default("XOF")
  status           PaymentStatus @default(PENDING)
  /// Référence interne unique transmise au fournisseur.
  reference        String        @unique
  /// Référence retournée par le fournisseur (transaction id).
  providerRef      String?
  failureReason    String?
  /// Charge utile non sensible renvoyée par le fournisseur.
  metadata         Json          @default("{}")
  /// Preuve de paiement déposée par le client (paiement mobile manuel).
  proofImageUrl    String?
  proofSubmittedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order      Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([restaurantId, status])
  @@index([orderId])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Plans & abonnements
// ---------------------------------------------------------------------------

enum BillingInterval {
  MONTH
  YEAR
}

model Plan {
  id          String          @id @default(cuid())
  key         String          @unique
  name        String
  description String?
  /// Prix en unité mineure. Jamais codé en dur dans l'application.
  price       Int
  currency    String          @default("XOF")
  interval    BillingInterval @default(MONTH)
  trialDays   Int             @default(14)
  /// Clés de fonctionnalités accordées (voir src/lib/entitlements.ts).
  features    String[]        @default([])
  /// Limites quantitatives : { maxProducts, maxUsers, maxCategories, ... }
  limits      Json            @default("{}")
  isActive    Boolean         @default(true)
  position    Int             @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions             Subscription[]
  subscriptionPayments      SubscriptionPayment[]
  storeSubscriptions        StoreSubscription[]
  storeSubscriptionPayments StoreSubscriptionPayment[]

  @@map("plans")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

model Subscription {
  id                String             @id @default(cuid())
  restaurantId      String             @unique
  planId            String
  status            SubscriptionStatus @default(TRIALING)
  startedAt         DateTime           @default(now())
  currentPeriodEnd  DateTime
  trialEndsAt       DateTime?
  cancelledAt       DateTime?
  /// Horodatage de l'alerte « expire dans 5 jours » déjà envoyée — évite de
  /// la renvoyer chaque jour. Remise à zéro à chaque renouvellement, pour
  /// qu'une prochaine échéance déclenche à nouveau l'alerte.
  expiryAlertSentAt DateTime?
  /// Fin du délai de grâce de 3 jours accordé après l'expiration d'une
  /// période, pendant lequel le restaurant peut encore renouveler avant de
  /// basculer automatiquement sur le plan le plus bas. `null` en dehors de
  /// ce délai.
  graceEndsAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  plan       Plan       @relation(fields: [planId], references: [id])

  @@index([status])
  @@map("subscriptions")
}

enum SubscriptionPaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

/**
 * Demande de paiement d'abonnement — voie manuelle : le restaurateur envoie
 * le montant sur le numéro Wave/Orange Money de la plateforme (configuré
 * dans `PlatformSettings`), dépose une preuve, le Super Admin valide. Même
 * principe que le paiement mobile manuel déjà utilisé pour les commandes
 * (`src/lib/payments/providers/manual-mobile-money.ts`), appliqué ici à
 * l'abonnement de la plateforme plutôt qu'à une commande d'un client.
 */
model SubscriptionPayment {
  id               String                    @id @default(cuid())
  restaurantId     String
  planId           String
  /// 'wave_manual' | 'orange_money_manual' — même vocabulaire que les
  /// fournisseurs de paiement de commande, pour rester cohérent.
  provider         String
  /// Pays depuis lequel le transfert est effectué — déclaré par le
  /// restaurateur avant paiement, utile pour rapprocher la preuve reçue.
  country          String?
  amount           Int
  currency         String                    @default("XOF")
  status           SubscriptionPaymentStatus @default(PENDING)
  proofImageUrl    String?
  proofSubmittedAt DateTime?
  note             String?
  reviewedByUserId String?
  reviewedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  plan       Plan       @relation(fields: [planId], references: [id])

  @@index([restaurantId, status])
  @@index([status])
  @@map("subscription_payments")
}

/**
 * Réglages globaux de la plateforme — ligne unique. Aujourd'hui limité aux
 * numéros receveurs des paiements d'abonnement ; peut accueillir d'autres
 * réglages de plateforme à l'avenir sans nouvelle table.
 */
model PlatformSettings {
  id                String  @id @default(cuid())
  waveNumber        String?
  orangeMoneyNumber String?

  /// Offre de lancement : remise en pourcentage appliquée automatiquement au
  /// premier paiement d'abonnement d'un restaurant, tant que `promoEndsAt`
  /// n'est pas dépassée. `null` = pas d'offre en cours.
  promoDiscountPercent Int?
  promoEndsAt          DateTime?
  /// Texte affiché sur le bandeau d'offre (ex. « -20% le premier mois »).
  promoLabel           String?

  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

// ---------------------------------------------------------------------------
// Templates & domaines
// ---------------------------------------------------------------------------

model Template {
  id              String  @id @default(cuid())
  key             String  @unique
  name            String
  description     String?
  previewImageUrl String?
  isActive        Boolean @default(true)
  position        Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("templates")
}

enum DomainType {
  SUBDOMAIN
  CUSTOM
}

enum DomainStatus {
  PENDING
  VERIFIED
  FAILED
}

model Domain {
  id                String       @id @default(cuid())
  restaurantId      String
  hostname          String       @unique
  type              DomainType   @default(CUSTOM)
  status            DomainStatus @default(PENDING)
  /// Valeur attendue dans l'enregistrement TXT _magyapro-verify.<hostname>
  verificationToken String
  verifiedAt        DateTime?
  lastCheckedAt     DateTime?
  isPrimary         Boolean      @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("domains")
}

// ---------------------------------------------------------------------------
// Notifications, analytics, audit
// ---------------------------------------------------------------------------

enum NotificationType {
  ORDER_CREATED
  ORDER_STATUS_CHANGED
  SUBSCRIPTION_TRIAL_ENDING
  SUBSCRIPTION_EXPIRED
  SYSTEM_ALERT
  TABLE_CALL
  TABLE_BILL_REQUEST
  RESERVATION_CREATED
  PAYMENT_PROOF_SUBMITTED
}

model Notification {
  id           String           @id @default(cuid())
  restaurantId String?
  /// Renseigné à la place de `restaurantId` pour une notification MagyaPro
  /// Boutique — jamais les deux à la fois.
  storeId      String?
  userId       String?
  type         NotificationType
  title        String
  body         String
  /// Lien interne à ouvrir au clic (ex: /dashboard/orders/<id>).
  href         String?
  metadata     Json             @default("{}")
  readAt       DateTime?
  createdAt    DateTime         @default(now())

  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  store      Store?      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user       User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([restaurantId, readAt])
  @@index([storeId, readAt])
  @@index([userId, readAt])
  @@map("notifications")
}

enum AnalyticsEventType {
  PAGE_VIEW
  PRODUCT_VIEW
  ADD_TO_CART
  CHECKOUT_STARTED
  ORDER_PLACED
}

model AnalyticsEvent {
  id           String             @id @default(cuid())
  restaurantId String
  type         AnalyticsEventType
  path         String?
  /// Identifiant de visiteur anonyme (cookie first-party, non nominatif).
  visitorId    String?
  metadata     Json               @default("{}")
  occurredAt   DateTime           @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, occurredAt])
  @@index([restaurantId, type, occurredAt])
  @@map("analytics_events")
}

enum ExpenseCategory {
  INGREDIENTS
  STAFF
  RENT
  UTILITIES
  OTHER
}

model Expense {
  id           String          @id @default(cuid())
  restaurantId String
  label        String
  /// Montant en unité mineure, comme tous les autres montants.
  amount       Int
  category     ExpenseCategory @default(OTHER)
  incurredAt   DateTime
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, incurredAt])
  @@map("expenses")
}

model GalleryImage {
  id           String  @id @default(cuid())
  restaurantId String
  imageUrl     String
  caption      String?
  position     Int     @default(0)

  createdAt DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, position])
  @@map("gallery_images")
}

model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  /// Conservé même si le compte est supprimé.
  actorEmail   String?
  restaurantId String?
  /// Renseigné à la place de `restaurantId` pour une action MagyaPro
  /// Boutique — jamais les deux à la fois. Journal commun aux deux
  /// produits : le Core reste le seul propriétaire de cette table.
  storeId      String?
  action       String
  targetType   String?
  targetId     String?
  ip           String?
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now())

  actor      User?       @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  store      Store?      @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([restaurantId, createdAt])
  @@index([storeId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

/// Traçabilité des accès support d'un Super Admin à l'espace d'un restaurant.
model SupportAccess {
  id           String    @id @default(cuid())
  adminUserId  String
  restaurantId String
  reason       String
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  ip           String?

  admin      User       @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, startedAt])
  @@index([adminUserId, startedAt])
  @@map("support_access")
}

enum AnnouncementSeverity {
  INFO
  WARNING
  CRITICAL
}

/// Message publié par un Super Admin, visible dans le dashboard de tous les
/// restaurants tant qu'il est dans sa fenêtre de publication.
model PlatformAnnouncement {
  id             String               @id @default(cuid())
  title          String
  body           String
  severity       AnnouncementSeverity @default(INFO)
  /// Conservé même si le compte administrateur est supprimé.
  createdByEmail String
  publishedAt    DateTime             @default(now())
  /// `null` = pas de date de fin programmée ; reste actif jusqu'à suppression.
  expiresAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publishedAt, expiresAt])
  @@map("platform_announcements")
}

// =============================================================================
// MAGYAPRO BOUTIQUE
//
// Second produit de la plateforme, indépendant de Restaurant : aucune de ses
// tables n'est référencée par le module Restaurant, et réciproquement. Seul
// le Core (User, Session, Plan, AuditLog, Notification, stockage, email/SMS)
// est partagé — voir `src/lib/boutique/store-tenant.ts` pour l'équivalent
// Boutique de `src/lib/tenant.ts`.
//
// Règle structurante identique à Restaurant : toute donnée appartenant à une
// boutique porte une colonne `storeId` non nullable et un index dessus,
// filtrée côté serveur — jamais depuis une valeur du client. Montants en
// entiers, unité mineure de la devise de la boutique. Aucun flottant pour
// l'argent.
// =============================================================================

// -----------------------------------------------------------------------
// Tenant & accès
// -----------------------------------------------------------------------

enum StoreRole {
  OWNER
  ADMIN
  MANAGER
  CASHIER
  SALESPERSON
  STOCK_MANAGER
  ACCOUNTANT
}

model StoreUser {
  id               String    @id @default(cuid())
  storeId          String
  userId           String
  role             StoreRole @default(SALESPERSON)
  /// Permissions accordées en plus de celles du rôle (système extensible,
  /// même principe que `RestaurantUser.extraPermissions`).
  extraPermissions String[]  @default([])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@index([userId])
  @@index([storeId])
  @@map("store_users")
}

enum StoreStatus {
  DRAFT
  ACTIVE
  SUSPENDED
}

enum StoreBusinessType {
  CLOTHING
  ELECTRONICS
  COSMETICS
  GROCERY
  OTHER
}

model Store {
  id           String            @id @default(cuid())
  /// Sous-domaine public : <slug>.boutique.magyapro.app
  slug         String            @unique
  name         String
  description  String?
  businessType StoreBusinessType @default(OTHER)
  status       StoreStatus       @default(DRAFT)
  isDemo       Boolean           @default(false)

  logoUrl        String?
  coverUrl       String?
  primaryColor   String  @default("#b45309")
  secondaryColor String  @default("#12151a")

  phone       String?
  email       String?
  addressLine String?
  city        String?
  country     String?

  currency String @default("XOF")
  timezone String @default("Africa/Abidjan")

  taxEnabled Boolean @default(false)
  /// Taux en dixièmes de pourcent (ex. 185 = 18,5 %), pour rester en entier.
  taxRate    Int     @default(0)

  onboardingStep        Int       @default(0)
  onboardingCompletedAt DateTime?

  /// Compteur de numérotation des ventes, incrémenté transactionnellement —
  /// même principe que `Restaurant.orderCounter`.
  saleCounter Int       @default(0)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  members              StoreUser[]
  subscription         StoreSubscription?
  subscriptionPayments StoreSubscriptionPayment[]
  domains              StoreDomain[]
  brands               Brand[]
  categories           StoreCategory[]
  products             StoreProduct[]
  warehouses           Warehouse[]
  inventoryMovements   InventoryMovement[]
  stockBatches         StockBatch[]
  suppliers            Supplier[]
  supplierPayments     SupplierPayment[]
  purchaseOrders       PurchaseOrder[]
  customers            StoreCustomer[]
  creditPayments       StoreCreditPayment[]
  sales                Sale[]
  returns              StoreReturn[]
  cashRegisters        CashRegister[]
  cashSessions         CashSession[]
  expenses             StoreExpense[]
  invoices             Invoice[]
  promotions           StorePromotion[]
  auditLogs            AuditLog[]
  notifications        Notification[]

  @@index([status])
  @@map("stores")
}

enum StoreDomainType {
  SUBDOMAIN
  CUSTOM
}

enum StoreDomainStatus {
  PENDING
  VERIFIED
  FAILED
}

/// Distinct de `Domain` (Restaurant) : même mécanique, jamais la même table —
/// une collision de nom d'hôte entre les deux produits doit rester possible
/// à traiter proprement (contrainte d'unicité propre à chaque table).
model StoreDomain {
  id                String            @id @default(cuid())
  storeId           String
  hostname          String            @unique
  type              StoreDomainType   @default(CUSTOM)
  status            StoreDomainStatus @default(PENDING)
  verificationToken String
  verifiedAt        DateTime?
  lastCheckedAt     DateTime?
  isPrimary         Boolean           @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("store_domains")
}

// -----------------------------------------------------------------------
// Abonnement — réutilise `Plan` (générique), jamais `Subscription`
// (Restaurant) : la contrainte d'unicité de `Subscription.restaurantId` en
// interdirait de toute façon le partage.
// -----------------------------------------------------------------------

model StoreSubscription {
  id                String             @id @default(cuid())
  storeId           String             @unique
  planId            String
  status            SubscriptionStatus @default(TRIALING)
  startedAt         DateTime           @default(now())
  currentPeriodEnd  DateTime
  trialEndsAt       DateTime?
  cancelledAt       DateTime?
  expiryAlertSentAt DateTime?
  graceEndsAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  plan  Plan  @relation(fields: [planId], references: [id])

  @@index([status])
  @@map("store_subscriptions")
}

model StoreSubscriptionPayment {
  id               String                    @id @default(cuid())
  storeId          String
  planId           String
  provider         String
  country          String?
  amount           Int
  currency         String                    @default("XOF")
  status           SubscriptionPaymentStatus @default(PENDING)
  proofImageUrl    String?
  proofSubmittedAt DateTime?
  note             String?
  reviewedByUserId String?
  reviewedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  plan  Plan  @relation(fields: [planId], references: [id])

  @@index([storeId, status])
  @@index([status])
  @@map("store_subscription_payments")
}

// -----------------------------------------------------------------------
// Catalogue
// -----------------------------------------------------------------------

model Brand {
  id      String  @id @default(cuid())
  storeId String
  name    String
  logoUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store    Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products StoreProduct[]

  @@unique([storeId, name])
  @@index([storeId])
  @@map("boutique_brands")
}

model StoreCategory {
  id       String  @id @default(cuid())
  storeId  String
  name     String
  /// Sous-catégorie : parent optionnel dans la même table.
  parentId String?
  position Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store    Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parent   StoreCategory?  @relation("StoreCategoryChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children StoreCategory[] @relation("StoreCategoryChildren")
  products StoreProduct[]

  @@unique([storeId, name, parentId])
  @@index([storeId])
  @@map("boutique_categories")
}

enum StoreProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

/// Unité d'affichage du produit. Les quantités restent des entiers dans
/// cette première version (voir le commentaire sur `StoreProduct.unit`) :
/// KG/LITER couvrent pour l'instant des produits vendus par pièce entière
/// dans cette unité (ex. un pack de 1 kg), pas une pesée fractionnée.
enum ProductUnit {
  UNIT
  KG
  GRAM
  LITER
  MILLILITER
  PACK
}

/// Une fiche produit. Le stock, le prix et le code-barres réels vivent
/// toujours sur `StoreProductVariant` — un produit sans variante déclarée par le
/// commerçant reçoit automatiquement une variante par défaut (créée par la
/// couche applicative, jamais par le schéma), pour n'avoir qu'un seul chemin
/// de gestion du stock.
model StoreProduct {
  id            String             @id @default(cuid())
  storeId       String
  categoryId    String?
  brandId       String?
  supplierId    String?
  name          String
  description   String?
  imageUrl      String?
  /// Attributs libres non couverts par les champs dédiés (ex. matière,
  /// garantie) — jamais utilisé pour du contenu qui doit être filtrable ou
  /// requêté : ces attributs-là méritent leur propre colonne.
  attributes    Json               @default("{}")
  status        StoreProductStatus @default(DRAFT)
  minStockAlert Int                @default(0)
  /// Unité dans laquelle le produit se vend et se stocke — un article
  /// (vêtement, appareil) se compte en unités entières, une denrée en poids
  /// ou volume. Détermine si les quantités saisies acceptent des décimales.
  unit          ProductUnit        @default(UNIT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store    Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category StoreCategory?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand    Brand?                @relation(fields: [brandId], references: [id], onDelete: SetNull)
  supplier Supplier?             @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  variants StoreProductVariant[]

  @@index([storeId, status])
  @@index([categoryId])
  @@index([brandId])
  @@map("boutique_products")
}

/// Unité réellement vendue et stockée. `attributes` porte la combinaison
/// d'options (ex. { "taille": "M", "couleur": "Rouge" }) — affichage libre,
/// sans table d'options séparée : la variabilité des attributs d'une
/// boutique à l'autre rendrait un schéma d'options rigide contre-productif.
model StoreProductVariant {
  id         String  @id @default(cuid())
  productId  String
  sku        String?
  barcode    String?
  attributes Json    @default("{}")
  /// Coût d'achat, en unité mineure — sert au calcul de marge.
  cost       Int     @default(0)
  price      Int
  /// Prix promotionnel actif, prioritaire sur `price` à l'affichage/vente.
  salePrice  Int?
  imageUrl   String?
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product            StoreProduct        @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory          Inventory[]
  inventoryMovements InventoryMovement[]
  saleItems          SaleItem[]
  purchaseOrderItems PurchaseOrderItem[]
  returnItems        StoreReturnItem[]
  stockBatches       StockBatch[]

  @@unique([productId, sku])
  @@index([productId])
  @@index([barcode])
  @@map("boutique_product_variants")
}

// -----------------------------------------------------------------------
// Stock
// -----------------------------------------------------------------------

model Warehouse {
  id        String  @id @default(cuid())
  storeId   String
  name      String
  /// Le point de vente principal de la boutique reçoit `isDefault = true` à
  /// sa création — toujours au moins un emplacement pour recevoir du stock.
  isDefault Boolean @default(false)
  address   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store              Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  inventory          Inventory[]
  inventoryMovements InventoryMovement[]
  transfersOut       StockTransfer[]     @relation("TransferSource")
  transfersIn        StockTransfer[]     @relation("TransferDestination")
  stockBatches       StockBatch[]

  @@index([storeId])
  @@map("boutique_warehouses")
}

/// Quantité en stock d'une variante dans un entrepôt donné. Jamais modifiée
/// directement : uniquement recalculée à partir des `InventoryMovement`
/// (voir plus bas), pour qu'aucune écriture ne puisse désynchroniser le
/// solde de son historique.
model Inventory {
  id               String @id @default(cuid())
  productVariantId String
  warehouseId      String
  quantity         Int    @default(0)
  /// Quantité retenue par des ventes non finalisées (panier en cours) — ne
  /// réduit pas `quantity`, mais réduit le disponible réel à la vente.
  reservedQuantity Int    @default(0)

  updatedAt DateTime @updatedAt

  productVariant StoreProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  warehouse      Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productVariantId, warehouseId])
  @@index([warehouseId])
  @@map("boutique_inventory")
}

enum StockMovementType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  INITIAL
}

/// Chaque mouvement de stock, sans exception — la table `Inventory` n'est
/// qu'une projection dénormalisée de la somme de ces mouvements, jamais la
/// source de vérité.
model InventoryMovement {
  id               String            @id @default(cuid())
  storeId          String
  productVariantId String
  warehouseId      String
  type             StockMovementType
  /// Négatif pour une sortie, positif pour une entrée.
  quantityChange   Int
  quantityBefore   Int
  quantityAfter    Int
  userId           String?
  reason           String?
  /// Référence de l'opération à l'origine du mouvement (ex. id de vente,
  /// d'achat, de transfert) — jamais interprétée, seulement affichée.
  referenceType    String?
  referenceId      String?
  createdAt        DateTime          @default(now())

  store          Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productVariant StoreProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  warehouse      Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
  @@index([productVariantId, createdAt])
  @@index([warehouseId, createdAt])
  @@map("boutique_inventory_movements")
}

/// Suivi par lot — uniquement pour les entrées de stock où une date de
/// péremption a été renseignée (réception d'achat, stock initial) ; une
/// entrée sans date n'a pas de lot, ce qui reste sans conséquence : le
/// dépérissement (voir `recordStockMovement`) ne fait qu'épuiser les lots
/// existants en priorité sur la date la plus proche, sans exiger qu'ils
/// couvrent tout le stock. Volontairement pas un système de coût par lot
/// (FIFO costing) : seule la date de péremption est trackée ici.
model StockBatch {
  id                String   @id @default(cuid())
  storeId           String
  productVariantId  String
  warehouseId       String
  quantity          Int
  remainingQuantity Int
  expiryDate        DateTime
  receivedAt        DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store          Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productVariant StoreProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  warehouse      Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([storeId, expiryDate])
  @@index([productVariantId, warehouseId, expiryDate])
  @@map("boutique_stock_batches")
}

enum StockTransferStatus {
  PENDING
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

model StockTransfer {
  id              String              @id @default(cuid())
  fromWarehouseId String
  toWarehouseId   String
  status          StockTransferStatus @default(PENDING)
  note            String?
  sentAt          DateTime?
  receivedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fromWarehouse Warehouse           @relation("TransferSource", fields: [fromWarehouseId], references: [id], onDelete: Cascade)
  toWarehouse   Warehouse           @relation("TransferDestination", fields: [toWarehouseId], references: [id], onDelete: Cascade)
  items         StockTransferItem[]

  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@map("boutique_stock_transfers")
}

model StockTransferItem {
  id               String @id @default(cuid())
  transferId       String
  productVariantId String
  quantity         Int

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId])
  @@map("boutique_stock_transfer_items")
}

// -----------------------------------------------------------------------
// Fournisseurs & achats
// -----------------------------------------------------------------------

model Supplier {
  id           String  @id @default(cuid())
  storeId      String
  name         String
  contactName  String?
  phone        String?
  email        String?
  address      String?
  paymentTerms String?
  /// Dette envers ce fournisseur, en unité mineure — recalculée à chaque
  /// commande reçue et à chaque paiement, jamais modifiée à la main.
  debtBalance  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store          Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products       StoreProduct[]
  purchaseOrders PurchaseOrder[]
  payments       SupplierPayment[]

  @@index([storeId])
  @@map("boutique_suppliers")
}

model SupplierPayment {
  id         String   @id @default(cuid())
  storeId    String
  supplierId String
  amount     Int
  paidAt     DateTime @default(now())
  note       String?

  createdAt DateTime @default(now())

  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([supplierId, paidAt])
  @@map("boutique_supplier_payments")
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id         String              @id @default(cuid())
  storeId    String
  supplierId String
  reference  String
  status     PurchaseOrderStatus @default(DRAFT)
  /// Frais annexes (transport, douane...) répartis sur le coût des lignes —
  /// affichés séparément, jamais fondus silencieusement dans les prix.
  extraFees  Int                 @default(0)
  note       String?
  orderedAt  DateTime?
  receivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store    Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  items    PurchaseOrderItem[]

  @@unique([storeId, reference])
  @@index([storeId, status])
  @@map("boutique_purchase_orders")
}

model PurchaseOrderItem {
  id               String @id @default(cuid())
  purchaseOrderId  String
  productVariantId String
  quantityOrdered  Int
  /// Cumul reçu — une réception partielle incrémente ce champ sans jamais le
  /// dépasser `quantityOrdered` (contrôlé côté application).
  quantityReceived Int    @default(0)
  unitCost         Int
  discount         Int    @default(0)

  purchaseOrder  PurchaseOrder       @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productVariant StoreProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@map("boutique_purchase_order_items")
}

// -----------------------------------------------------------------------
// Clients & crédit
// -----------------------------------------------------------------------

model StoreCustomer {
  id      String  @id @default(cuid())
  storeId String
  name    String
  phone   String
  email   String?
  address String?
  notes   String?

  /// Agrégats dénormalisés, recalculés à chaque vente — même principe que
  /// `Customer` (Restaurant).
  salesCount Int       @default(0)
  totalSpent Int       @default(0)
  lastSaleAt DateTime?

  /// Solde dû par le client, en unité mineure — recalculé à chaque vente à
  /// crédit et à chaque paiement, jamais modifié à la main.
  creditBalance Int @default(0)
  creditLimit   Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store          Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sales          Sale[]
  creditPayments StoreCreditPayment[]

  @@unique([storeId, phone])
  @@index([storeId])
  @@map("boutique_customers")
}

model StoreCreditPayment {
  id         String   @id @default(cuid())
  storeId    String
  customerId String
  amount     Int
  paidAt     DateTime @default(now())
  note       String?

  createdAt DateTime @default(now())

  store    Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer StoreCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([customerId, paidAt])
  @@map("boutique_credit_payments")
}

// -----------------------------------------------------------------------
// Ventes (POS)
// -----------------------------------------------------------------------

enum SaleStatus {
  COMPLETED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
}

model Sale {
  id            String     @id @default(cuid())
  storeId       String
  /// Numéro affiché au client — suite de `Store.saleCounter`, jamais
  /// l'identifiant technique.
  number        Int
  customerId    String?
  cashSessionId String?
  userId        String?
  status        SaleStatus @default(COMPLETED)
  subtotal      Int
  discount      Int        @default(0)
  taxAmount     Int        @default(0)
  total         Int
  /// Part réglée à crédit (compte client) sur le total — le reste est
  /// couvert par les lignes de `StorePayment`.
  creditAmount  Int        @default(0)
  note          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store       Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer    StoreCustomer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  cashSession CashSession?    @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  items       SaleItem[]
  payments    StorePayment[]
  returns     StoreReturn[]
  invoice     Invoice?
  promotion   StorePromotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  promotionId String?

  @@unique([storeId, number])
  @@index([storeId, createdAt])
  @@index([customerId])
  @@map("boutique_sales")
}

model SaleItem {
  id               String  @id @default(cuid())
  saleId           String
  productVariantId String
  /// Nom et attributs figés au moment de la vente : une fiche produit
  /// modifiée ou supprimée plus tard ne doit jamais réécrire l'historique
  /// des ventes déjà réalisées.
  productName      String
  variantLabel     String?
  quantity         Int
  unitPrice        Int
  discount         Int     @default(0)
  total            Int

  sale           Sale                @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productVariant StoreProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productVariantId])
  @@map("boutique_sale_items")
}

/// Un règlement sur une vente. Plusieurs lignes possibles (paiement scindé :
/// une partie espèces, une partie mobile money).
model StorePayment {
  id        String  @id @default(cuid())
  saleId    String
  /// Identifiant libre du moyen de paiement (ex. 'cash', 'wave',
  /// 'orange_money', 'card') — jamais un identifiant ou numéro de compte en
  /// dur : voir `StorePaymentMethod` pour la configuration par boutique.
  method    String
  amount    Int
  reference String?

  createdAt DateTime @default(now())

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@map("boutique_payments")
}

/// Moyens de paiement activés par une boutique, configurés depuis son
/// tableau de bord — jamais codés en dur dans l'application.
model StorePaymentMethod {
  id        String  @id @default(cuid())
  storeId   String
  /// Même vocabulaire que `StorePayment.method`.
  method    String
  label     String
  isEnabled Boolean @default(true)
  position  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, method])
  @@index([storeId])
  @@map("boutique_payment_methods")
}

// -----------------------------------------------------------------------
// Retours
// -----------------------------------------------------------------------

enum StoreReturnStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum StoreReturnResolution {
  REFUND
  EXCHANGE
}

model StoreReturn {
  id         String                 @id @default(cuid())
  storeId    String
  saleId     String
  status     StoreReturnStatus      @default(PENDING)
  resolution StoreReturnResolution?
  reason     String?
  userId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sale  Sale              @relation(fields: [saleId], references: [id], onDelete: Cascade)
  items StoreReturnItem[]

  @@index([storeId, createdAt])
  @@index([saleId])
  @@map("boutique_returns")
}

model StoreReturnItem {
  id               String @id @default(cuid())
  returnId         String
  productVariantId String
  quantity         Int
  unitPrice        Int

  return         StoreReturn         @relation(fields: [returnId], references: [id], onDelete: Cascade)
  productVariant StoreProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@index([returnId])
  @@map("boutique_return_items")
}

// -----------------------------------------------------------------------
// Caisses
// -----------------------------------------------------------------------

model CashRegister {
  id       String  @id @default(cuid())
  storeId  String
  name     String
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store    Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sessions CashSession[]

  @@index([storeId])
  @@map("boutique_cash_registers")
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

model CashSession {
  id              String            @id @default(cuid())
  storeId         String
  cashRegisterId  String
  userId          String?
  status          CashSessionStatus @default(OPEN)
  openingBalance  Int
  /// Solde théorique en fin de session — calculé à la fermeture à partir de
  /// `openingBalance` + mouvements + ventes en espèces.
  expectedBalance Int?
  /// Solde réellement compté par l'utilisateur à la fermeture.
  countedBalance  Int?
  /// `countedBalance - expectedBalance` — jamais recalculé après coup.
  difference      Int?
  openedAt        DateTime          @default(now())
  closedAt        DateTime?

  store        Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  cashRegister CashRegister   @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)
  sales        Sale[]
  movements    CashMovement[]

  @@index([storeId, status])
  @@index([cashRegisterId])
  @@map("boutique_cash_sessions")
}

enum CashMovementType {
  SALE
  DEPOSIT
  WITHDRAWAL
  EXPENSE
}

model CashMovement {
  id            String           @id @default(cuid())
  cashSessionId String
  type          CashMovementType
  amount        Int
  reason        String?
  userId        String?

  createdAt DateTime @default(now())

  cashSession CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)

  @@index([cashSessionId, createdAt])
  @@map("boutique_cash_movements")
}

// -----------------------------------------------------------------------
// Dépenses & finances
// -----------------------------------------------------------------------

enum StoreExpenseCategory {
  RENT
  UTILITIES
  STAFF
  TRANSPORT
  MARKETING
  MAINTENANCE
  SUPPLIES
  OTHER
}

model StoreExpense {
  id         String               @id @default(cuid())
  storeId    String
  label      String
  amount     Int
  category   StoreExpenseCategory @default(OTHER)
  incurredAt DateTime
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, incurredAt])
  @@map("boutique_expenses")
}

// -----------------------------------------------------------------------
// Factures
// -----------------------------------------------------------------------

model Invoice {
  id       String   @id @default(cuid())
  storeId  String
  saleId   String   @unique
  number   String
  issuedAt DateTime @default(now())

  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sale  Sale  @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@unique([storeId, number])
  @@index([storeId])
  @@map("boutique_invoices")
}

// -----------------------------------------------------------------------
// Promotions
// -----------------------------------------------------------------------

enum StorePromotionType {
  PERCENT
  FIXED
}

model StorePromotion {
  id             String             @id @default(cuid())
  storeId        String
  code           String
  type           StorePromotionType
  /// Pourcentage (1-100) si PERCENT, montant en unité mineure si FIXED.
  value          Int
  minCartAmount  Int                @default(0)
  maxRedemptions Int?
  usedCount      Int                @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  isActive       Boolean            @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sales Sale[]

  @@unique([storeId, code])
  @@index([storeId])
  @@map("boutique_promotions")
}
