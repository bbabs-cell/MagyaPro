# ---------------------------------------------------------------------------
# Magyapro — variables d'environnement
# Copiez ce fichier vers `.env` et renseignez les valeurs.
# Ne committez JAMAIS le fichier `.env` (il est ignoré par git).
# ---------------------------------------------------------------------------

# Base de données PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/magyapro_dev?schema=public"
# Base utilisée par `npm test` — elle est réinitialisée à chaque exécution.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/magyapro_test?schema=public"

# Secret de signature des sessions et des jetons (email, reset).
# Générez-le avec : openssl rand -base64 48
SESSION_SECRET="changez-moi-en-production-minimum-32-caracteres"

# Domaine racine servant les sites publics en sous-domaine :
# <slug>.magyapro.app  →  APP_ROOT_DOMAIN="magyapro.app"
APP_ROOT_DOMAIN="magyapro.localhost:3000"
# URL canonique de l'application (utilisée pour les liens des emails et le SEO).
NEXT_PUBLIC_APP_URL="http://magyapro.localhost:3000"

# --- Stockage des images -----------------------------------------------------
# local  : écrit dans public/uploads (développement, mono-serveur)
# s3     : nécessite les variables S3_* ci-dessous
STORAGE_DRIVER="local"
# Hôte public du CDN, déclaré à next/image quand un driver distant est utilisé.
# NEXT_PUBLIC_STORAGE_HOST="cdn.magyapro.app"
# S3_ENDPOINT=""
# S3_REGION=""
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# --- Email -------------------------------------------------------------------
# console : les emails sont écrits dans les logs serveur (développement)
# smtp    : connexion TCP directe (SMTP_*) — fonctionne sur un serveur Node
#           classique (Railway, VPS...), PAS sur Cloudflare Workers.
# resend  : API HTTP (RESEND_API_KEY) — seul pilote fiable sur Cloudflare
#           Workers, fonctionne aussi partout ailleurs.
MAIL_DRIVER="console"
MAIL_FROM="Magyapro <no-reply@magyapro.app>"
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""
# "true" pour TLS implicite (port 465) ; sinon STARTTLS sur le port indiqué.
# SMTP_SECURE="false"
# RESEND_API_KEY=""

# --- Paiements ---------------------------------------------------------------
# Les fournisseurs actifs sont choisis par restaurant dans ses réglages.
# Les identifiants ci-dessous ne sont lus que si le fournisseur est configuré.
# Aucun secret ne doit être écrit dans le code source.
#
# Wave : API Checkout réelle (docs.wave.com/checkout). Clé obtenue depuis le
# Wave Business Portal. Configurez aussi l'URL de webhook
# https://<votre-domaine>/api/webhooks/paiements/wave sur ce portail, et
# copiez le secret de signature qu'il fournit dans WAVE_WEBHOOK_SECRET.
# WAVE_API_KEY=""
# WAVE_WEBHOOK_SECRET=""
#
# Orange Money : point d'extension déclaré mais non implémenté. Son API n'est
# documentée qu'après inscription sur Orange Partner — voir
# src/lib/payments/providers/mobile-money.ts pour brancher un compte réel.
# ORANGE_MONEY_API_KEY=""
# ORANGE_MONEY_MERCHANT_ID=""

# --- Compte Super Admin initial (créé par `npm run db:seed`) -----------------
SEED_SUPER_ADMIN_EMAIL="admin@magyapro.app"
SEED_SUPER_ADMIN_PASSWORD="Admin!2345"
