{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "types": ["node"],
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // `tests/` est exclu ici volontairement : ce tsconfig est aussi celui que
  // `next build` utilise pour son propre typecheck, et les fichiers de test
  // ont besoin des globales Vitest (describe/it/expect) que ce projet
  // n'expose pas. Voir tsconfig.test.json (`npm run typecheck:tests`) pour
  // le typecheck des tests eux-mêmes.
  "exclude": ["node_modules", "tests"]
}
